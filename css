body {
    background-color: #f5f5f5;
    margin: 20px;
    font-family: Arial, sans-serif;
}


/* Main Heading */

h1 {
    text-align: center;
    font-family: Arial, sans-serif;
    text-transform: capitalize;
    color: #002f34;
    font-size: 3em;
}


/* Section Heading */

h2 {
    text-align: left;
    font-family: Verdana, sans-serif;
    text-transform: capitalize;
    margin-top: 30px;
}


/* Category Cards */

.card {
    width: 120px;
    height: 150px;
    background-color: white;
    display: inline-block;
    text-align: center;
    margin: 10px;
    vertical-align: top;
    border: 1px solid #ddd;
    border-radius: 5px;
}

.card img {
    width: 90px;
    height: 90px;
    background-color: #f5f5f5;
    border-radius: 10px;
    margin-top: 10px;
}

.card h3 {
    font-family: Arial, sans-serif;
    font-size: 13px;
    margin: 5px;
}


/* OLX Product Cards */

.product {
    width: 250px;
    height: 350px;
    background-color: white;
    border: 1px solid #ddd;
    border-radius: 5px;
    display: inline-block;
    margin: 10px;
    vertical-align: top;
}

.product img {
    width: 250px;
    height: 200px;
    border-radius: 5px 5px 0 0;
}

.product h3 {
    font-family: Arial, sans-serif;
    font-size: 18px;
    margin: 10px;
    color: #222;
}

.product p {
    font-family: Arial, sans-serif;
    font-size: 14px;
    margin: 8px 10px;
    color: #555;
}
